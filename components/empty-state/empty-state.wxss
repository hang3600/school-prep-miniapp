.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
}
.empty-circle {
  width: 160rpx;
  height: 160rpx;
  border-radius: 80rpx;
  background: #e7f3ed;
  display: flex;
  align-items: center;
  justify-content: center;
}
.empty-illu {
  width: 96rpx;
  height: 96rpx;
}
.empty-title {
  font-size: 33rpx;
  font-weight: 600;
  color: #242922;
  margin-top: 31rpx;
}
.empty-sub {
  font-size: 25rpx;
  color: #8c8a80;
  margin-top: 12rpx;
  text-align: center;
}
.empty-btn {
  margin-top: 38rpx;
  height: 84rpx;
  padding: 0 60rpx;
  background: #2f8f6b;
  color: #ffffff;
  border-radius: 27rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 29rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.12);
}
.empty-btn::after { border: none; }

/* ===== 按压反馈（组件样式隔离，需自带 hv-press 定义） ===== */
.empty-btn {
  transition: transform 0.15s ease, opacity 0.15s ease;
}
.hv-press {
  opacity: 0.72;
  transform: scale(0.97);
}
