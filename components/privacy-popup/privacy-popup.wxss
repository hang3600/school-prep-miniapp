.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}
.dialog {
  width: 600rpx;
  max-height: 70vh;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 36rpx 28rpx;
  display: flex;
  flex-direction: column;
}
.title {
  font-size: 34rpx;
  font-weight: 600;
  color: #242922;
  text-align: center;
  margin-bottom: 20rpx;
}
.body {
  flex: 1;
  font-size: 26rpx;
  line-height: 44rpx;
  color: #5c5a50;
  max-height: 420rpx;
}
.link {
  color: #2f8f6b;
}
.btns {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}
.btn {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 999rpx;
  font-size: 28rpx;
}
.btn.cancel {
  background: #f0efe9;
  color: #8c8a80;
}
.btn.ok {
  background: #2f8f6b;
  color: #fff;
  /* 重置 button 默认样式，使其与相邻的 view 按钮视觉一致 */
  margin: 0;
  padding: 22rpx 0;
  line-height: 1.4;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 400;
}
.btn.ok::after {
  border: none;
}

/* ===== 按压反馈（组件样式隔离，需自带 hv-press 定义） ===== */
.link,
.btn {
  transition: transform 0.15s ease, opacity 0.15s ease;
}
.hv-press {
  opacity: 0.72;
  transform: scale(0.97);
}
