.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 200;
  display: flex;
  align-items: flex-end;
}
.sheet {
  position: relative;
  width: 100%;
  background: #ffffff;
  border-radius: 54rpx 54rpx 0 0;
  padding: 23rpx 38rpx calc(38rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -15rpx 46rpx rgba(0, 0, 0, 0.16);
  animation: sheet-up 0.25s ease;
}
@keyframes sheet-up {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #e6e4db;
  margin: 0 auto 23rpx;
}
.sheet-title {
  font-size: 35rpx;
  font-weight: 700;
  color: #242922;
}
/* 右上角关闭：72rpx 圆形热区（≈37pt 见方），内部图标 32rpx */
.sheet-close {
  position: absolute;
  top: 19rpx;
  right: 30rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background: #f7f6f1;
  display: flex;
  align-items: center;
  justify-content: center;
}
.sheet-close .ic-close { width: 32rpx; height: 32rpx; }
.field { margin-top: 31rpx; }
.field.row { display: flex; align-items: center; justify-content: space-between; }
.field-label { font-size: 25rpx; color: #8c8a80; }
.field-input {
  margin-top: 12rpx;
  height: 77rpx;
  background: #f7f6f1;
  border-radius: 27rpx;
  padding: 0 23rpx;
  font-size: 27rpx;
  color: #242922;
}
.cat-chips { display: flex; flex-wrap: wrap; gap: 15rpx; margin-top: 12rpx; }
.cat-chip {
  padding: 10rpx 23rpx;
  background: #e7f3ed;
  color: #2f8f6b;
  font-size: 23rpx;
  font-weight: 600;
  border-radius: 23rpx;
}
.cat-chip.active { background: #2f8f6b; color: #ffffff; }
.stepper { display: flex; align-items: center; gap: 23rpx; margin-top: 12rpx; }
.step-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 30rpx;
  background: #f7f6f1;
  color: #242922;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 35rpx;
}
.step-num { font-size: 29rpx; font-weight: 600; min-width: 40rpx; text-align: center; }
.must-toggle {
  padding: 10rpx 23rpx;
  border-radius: 23rpx;
  font-size: 23rpx;
  background: #f0efe9;
  color: #a7a398;
}
.must-toggle.on { background: #e7f3ed; color: #2f8f6b; }
.save-btn {
  margin-top: 38rpx;
  height: 88rpx;
  background: #2f8f6b;
  color: #ffffff;
  border-radius: 27rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 29rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.12);
}
.save-btn::after { border: none; }

/* ===== 按压反馈（组件样式隔离，需自带 hv-press 定义） ===== */
.cat-chip,
.step-btn,
.must-toggle,
.save-btn,
.sheet-close {
  transition: transform 0.15s ease, opacity 0.15s ease;
}
.hv-press {
  opacity: 0.72;
  transform: scale(0.97);
}
