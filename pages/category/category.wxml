<view class="screen">

  <scroll-view class="content" scroll-y>
    <view class="content-inner">
      <!-- 搜索 -->
      <view class="search-bar">
        <image class="search-ic" src="/images/icons/ic-search.svg" mode="aspectFit" />
        <input class="search-input" placeholder="搜索开学必备物品" value="{{keyword}}" bindinput="onSearch" confirm-type="search" />
      </view>

      <!-- 最近添加（尚无自定义物品时隐藏） -->
      <block wx:if="{{recent.length > 0}}">
        <text class="section-title">最近添加</text>
        <scroll-view class="recent-scroll" scroll-x enable-flex>
          <view class="recent-row">
            <view wx:for="{{recent}}" wx:key="id" class="recent-chip" hover-class="hv-press" hover-stay-time="60" data-key="{{item.catKey}}" bindtap="onRecentTap">{{item.name}}</view>
          </view>
        </scroll-view>
      </block>

      <!-- 全部分类 -->
      <text class="section-title">开学物品全部分类</text>
      <view wx:if="{{categories.length === 0}}" class="search-empty">
        <text class="se-text">没有找到与「{{keyword}}」相关的分类或物品</text>
      </view>
      <view wx:else class="cat-list">
        <view
          wx:for="{{categories}}"
          wx:key="key"
          class="cat-card"
          hover-class="hv-press"
          hover-stay-time="60"
          data-key="{{item.key}}"
          bindtap="onCatTap"
        >
          <view class="cat-icon" style="background:{{item.tint}}">
            <image class="cat-icon-img" src="/images/icons/ic-cat-{{item.key}}.svg" mode="aspectFit" />
          </view>
          <view class="cat-mid">
            <text class="cat-name">{{item.label}}</text>
            <text class="cat-desc">{{item.desc}}</text>
          </view>
          <text class="cat-count num">{{item.count}}</text>
          <image class="cat-chevron" src="/images/icons/ic-chevron.svg" mode="aspectFit" />
        </view>
      </view>
    </view>
  </scroll-view>
</view>
