<view class="screen">

  <scroll-view class="content" scroll-y>
    <view class="content-inner">
      <!-- 三步上手 -->
      <view class="card steps-card">
        <text class="sec-title">三步上手</text>
        <view class="step-row">
          <view class="step-num num">1</view>
          <view class="step-mid">
            <text class="step-title">选择学段</text>
            <text class="step-desc">大学 / 高中 / 初中 / 小学，清单内容各不相同</text>
          </view>
        </view>
        <view class="step-row">
          <view class="step-num num">2</view>
          <view class="step-mid">
            <text class="step-title">逐类勾选</text>
            <text class="step-desc">证件材料、生活用品、学习用品等 7 大分类</text>
          </view>
        </view>
        <view class="step-row">
          <view class="step-num num">3</view>
          <view class="step-mid">
            <text class="step-title">看进度出行</text>
            <text class="step-desc">首页实时显示整理百分比，临行前再核对一遍</text>
          </view>
        </view>
      </view>

      <!-- 常见问题 -->
      <text class="sec-title outer">常见问题</text>
      <view class="card faq-card">
        <view
          wx:for="{{faqs}}"
          wx:key="q"
          class="faq-item"
          hover-class="hv-press"
          hover-stay-time="60"
          data-idx="{{index}}"
          bindtap="onToggle"
        >
          <view class="faq-head">
            <text class="faq-q">{{item.q}}</text>
            <image class="faq-chevron {{item.open ? 'open' : ''}}" src="/images/icons/ic-chevron.svg" mode="aspectFit" />
          </view>
          <text wx:if="{{item.open}}" class="faq-a">{{item.a}}</text>
        </view>
      </view>

      <!-- 在线客服 -->
      <view class="tip-card">
        <text class="tip-text">没有找到答案？点下方按钮直接在线咨询。</text>
        <button class="contact-btn" open-type="contact" hover-class="hv-press" hover-stay-time="60">
          <text>在线客服</text>
        </button>
      </view>
    </view>
  </scroll-view>
</view>
