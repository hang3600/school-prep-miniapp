.screen {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg-grad);
}

/* ===== 滚动区 ===== */
.content {
  flex: 1;
  overflow: hidden;
}
.content-inner {
  padding: 0 var(--sp-screen-x);
  padding-bottom: calc(var(--tab-bar-h) + env(safe-area-inset-bottom) + 30rpx);
  display: flex;
  flex-direction: column;
  gap: var(--sp-gap);
}

/* ===== Hero · B 开学时间带（白底，绿时间带为签名物件） ===== */
.hero {
  padding: 8rpx 0 4rpx;
}
.hero-title {
  display: block;
  font-size: var(--fs-sub);
  color: var(--ink-2); /* 打磨环R1: 原 --gray 在暖白底仅 3.34:1, 未达 4.5:1 可读性底线 */
  letter-spacing: 1rpx;
}
.hero-num-row {
  display: flex;
  align-items: baseline;
  margin-top: 10rpx;
}
.hero-num {
  font-size: 100rpx;
  font-weight: 500;
  line-height: 1;
  color: var(--brand);
}
.hero-pct {
  font-size: var(--fs-title);
  font-weight: 500;
  color: var(--gray);
  margin-left: 12rpx;
}
.hero-num-set {
  font-size: 44rpx;
  font-weight: 600;
  color: var(--brand);
}
.hero-date {
  display: block;
  font-size: var(--fs-indicator);
  color: var(--ink-2); /* 打磨环R1: 可读性 3.34→6.68:1 */
  margin-top: 12rpx;
}

/* 时间带：四段等宽胶囊，当前段实心绿，其余浅灰 */
.band {
  display: flex;
  gap: 8rpx;
  margin-top: 30rpx;
  transition: opacity 0.15s ease;
}
.band-seg {
  flex: 1;
  height: 14rpx;
  border-radius: 7rpx;
  background: #E4E6E0;
}
.band-seg.active {
  background: var(--brand);
}
.band-labels {
  display: flex;
  gap: 8rpx;
  margin-top: 14rpx;
}
.band-label {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: var(--gray);
}
.band-label.active {
  color: var(--brand);
  font-weight: 600;
}

/* 当前阶段建议：可点改日期 */
.advice-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 28rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid var(--border);
  transition: opacity 0.15s ease;
}
.advice-text {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-body);
  color: var(--ink-2);
  line-height: 1.55;
}
.cd-edit {
  font-size: 22rpx;
  color: var(--brand);
  flex-shrink: 0;
  padding-top: 2rpx;
}
.cd-press { opacity: 0.7; }

/* 整理进度：一行带过 */
.hero-progress {
  margin-top: 8rpx;
}
.hero-progress-label {
  display: block;
  font-size: var(--fs-indicator);
  color: var(--ink-2); /* 打磨环R1: 可读性 3.34→6.68:1 */
}
.hero-desc {
  display: block;
  font-size: var(--fs-indicator);
  color: var(--ink-2); /* 打磨环R1: 可读性 3.34→6.68:1 */
  margin-top: 8rpx;
}
.hero-track {
  height: 8rpx;
  background: #EDEFE9;
  border-radius: 4rpx;
  margin-top: 14rpx;
  overflow: hidden;
}
.hero-fill {
  height: 100%;
  background: var(--brand);
  border-radius: 4rpx;
  transition: width 0.4s cubic-bezier(0.25, 0.8, 0.35, 1);
}

/* ===== 学段切换 ===== */
.stage-seg {
  display: flex;
  gap: 15rpx;
  background: #ffffff;
  border-radius: var(--r-tab-pill);
  padding: 8rpx;
  box-shadow: var(--shadow-1);
}
.stage-pill {
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50rpx;
  font-size: var(--fs-body);
  color: var(--gray);
}
.stage-pill.active {
  background: var(--brand);
  color: #ffffff;
  font-weight: 600;
}

/* ===== 清单范围切换（核心 20 件 / 完整）===== */
.scope-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: -8rpx;
}
.scope-label { font-size: var(--fs-sub); color: var(--gray); }
.scope-seg {
  display: flex;
  gap: 8rpx;
  background: var(--brand-soft);
  border-radius: var(--r-tab-pill);
  padding: 6rpx;
}
.scope-pill {
  padding: 12rpx 24rpx;
  border-radius: 44rpx;
  font-size: var(--fs-indicator);
  color: var(--brand-deep);
  transition: opacity 0.15s, transform 0.15s;
}
.scope-pill.active {
  background: var(--brand);
  color: #ffffff;
  font-weight: 600;
}

/* ===== 分类宫格 ===== */
.section-title {
  font-size: var(--fs-section);
  font-weight: 600;
  color: var(--ink);
  margin-top: 8rpx;
}
.grid {
  display: grid;
  /* 7 个分类（含军训）：4 列排布 4+3，比 3 列的 3+3+1 更整齐 */
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}
.grid-cell {
  background: #ffffff;
  border-radius: var(--r-card);
  padding: 20rpx 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  box-shadow: var(--shadow-1);
}
.grid-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.grid-icon-img {
  width: 48rpx;
  height: 48rpx;
}
.grid-label {
  font-size: var(--fs-indicator);
  color: var(--ink);
  text-align: center;
  white-space: nowrap;
}
.grid-count {
  font-size: 22rpx;
  color: var(--gray);
}

/* ===== 触感反馈 ===== */
.stage-pill:active { opacity: 0.75; }
.grid-cell:active { transform: scale(0.97); }

/* ===== 按压反馈过渡 ===== */
.stage-pill,
.grid-cell {
  transition: transform 0.15s ease, opacity 0.15s ease;
}

/* ===== 今日整理小贴士（填充宫格下方留白，按日期轮换） ===== */
.tips-card {
  margin-top: var(--sp-gap);
  background: #ffffff;
  border: 1rpx solid var(--border);
  border-radius: var(--r-card);
  padding: 30rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  box-shadow: var(--shadow-1);
}
.tips-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.tips-ic {
  width: 44rpx;
  height: 44rpx;
}
.tips-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
}
.tips-text {
  font-size: 26rpx;
  line-height: 1.7;
  color: #5a6478;
  text-wrap: pretty; /* 打磨环R1: 避免末行孤字（不支持的基础库自动降级，无害） */
}

/* ===== 首次学段引导弹层（自定义半屏 2×2 卡片） ===== */
.sg-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.38);
  z-index: 900;
  animation: sg-fade-in 0.2s ease-out;
}
.sg-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 16rpx 36rpx calc(44rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  animation: sg-slide-up 0.28s cubic-bezier(0.22, 1, 0.36, 1);
}
.sg-handle {
  width: 72rpx;
  height: 8rpx;
  background: #E4E3DD;
  border-radius: 4rpx;
  margin: 0 auto 24rpx;
}
.sg-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #1A1B1C;
  text-align: center;
}
.sg-sub {
  font-size: 24rpx;
  color: #6B7280;
  text-align: center;
  margin-top: 12rpx;
  line-height: 1.5;
}
.sg-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  margin-top: 36rpx;
}
.sg-card {
  position: relative;
  background: #ffffff;
  border: 4rpx solid #E4E3DD;
  border-radius: 28rpx;
  padding: 28rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  transition: border-color 0.15s ease, background 0.15s ease;
}
.sg-card.active {
  background: #e7f3ed;
  border-color: var(--brand);
}
.sg-card-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
}
.sg-card-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1B1C;
}
.sg-card-desc {
  font-size: var(--fs-indicator);
  color: #6B7280;
}
.sg-card-check {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 32rpx;
  height: 32rpx;
  background: var(--brand);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.sg-card-check-inner {
  width: 14rpx;
  height: 7rpx;
  border-left: 4rpx solid #ffffff;
  border-bottom: 4rpx solid #ffffff;
  transform: rotate(-45deg);
  margin-top: -4rpx;
}
.sg-later {
  text-align: center;
  font-size: 28rpx;
  font-weight: 500;
  color: #6B7280;
  margin-top: 32rpx;
  padding: 18rpx 0;
  background: #F4F3EE;
  border-radius: 12rpx;
}
@keyframes sg-fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}
@keyframes sg-slide-up {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}


/* ===== 强 CTA：首页承接主入口 ===== */
.cta-wrap {
  margin-top: var(--sp-gap);
}
.cta-btn {
  background: linear-gradient(135deg, #3fa37d 0%, #247454 100%);
  border-radius: 22rpx;
  padding: 30rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: var(--shadow-2);
  transition: transform 0.15s ease, opacity 0.15s ease;
}
.cta-press {
  opacity: 0.9;
  transform: scale(0.985);
}
.cta-main {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
  min-width: 0;
}
.cta-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1.1;
}
.cta-sub {
  font-size: var(--fs-indicator);
  color: rgba(255, 255, 255, 0.88);
  line-height: 1.4;
}
.cta-arrow {
  font-size: 48rpx;
  color: #ffffff;
  font-weight: 700;
  margin-left: 20rpx;
  flex-shrink: 0;
}

/* ===== 清单抢先看：横向胶囊条（省空间，让宫格/CTA 进首屏） ===== */
.preview-card {
  margin-top: var(--sp-gap);
  background: #ffffff;
  border: 1rpx solid var(--border);
  border-radius: var(--r-card);
  padding: 22rpx 24rpx 24rpx;
  box-shadow: var(--shadow-1);
}
.preview-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.preview-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ink);
}
.preview-more {
  font-size: var(--fs-indicator);
  color: var(--brand);
  flex-shrink: 0;
  margin-left: 16rpx;
}
/* 横向滚动：scroll-x + white-space:nowrap，胶囊 inline-flex 不换行 */
.preview-scroll {
  width: 100%;
  white-space: nowrap;
}
.chip {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  height: 52rpx;
  padding: 0 20rpx;
  margin-right: 12rpx;
  border-radius: 26rpx;
  vertical-align: middle;
  background: var(--brand-soft);
}
.chip-name {
  font-size: 24rpx;
  color: var(--brand-deep);
  font-weight: 600;
  white-space: nowrap;
}
.chip.opt {
  background: #F2F3F5;
}
.chip.opt .chip-name {
  color: var(--gray);
  font-weight: 500;
}
.chip.done {
  background: #F2F3F5;
}
.chip.done .chip-name {
  color: var(--gray);
  font-weight: 400;
  text-decoration: line-through;
}
.chip-more {
  background: transparent;
  border: 1rpx solid var(--border);
  font-size: 24rpx;
  color: var(--gray);
  font-weight: 500;
}
.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.dot.st0 { background: #C9CDD4; }
.dot.st1 { background: var(--brand); }
.dot.st2 { background: #52C41A; }
