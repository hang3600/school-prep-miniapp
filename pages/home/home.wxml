<view class="screen">

  <scroll-view class="content" scroll-y>
    <view class="content-inner">
      <!-- Hero · B 开学时间带：大数字 + 四段时间带 + 当前阶段该做什么 -->
      <view class="hero">
        <text class="hero-title">开学倒计时</text>

        <!-- 大数字：未设置日期时显示文字，设置后显示剩余天数 -->
        <view class="hero-num-row">
          <block wx:if="{{daysLeft !== null}}">
            <text class="hero-num num">{{daysLeft}}</text>
            <text class="hero-pct">天后开学</text>
          </block>
          <text wx:else class="hero-num-set">{{countdownText}}</text>
        </view>
        <text class="hero-date" wx:if="{{schoolDateText}}">{{schoolDateText}}</text>

        <!-- 四段时间带：当前段实心绿，其余浅灰；未设置日期时全部灰 -->
        <picker mode="date" start="{{dateStart}}" end="{{dateEnd}}" bindchange="onDateChange">
          <view class="band" hover-class="cd-press" hover-stay-time="60">
            <view
              wx:for="{{phaseBands}}"
              wx:key="key"
              class="band-seg {{activePhase === index ? 'active' : ''}}"
            ></view>
          </view>
        </picker>
        <view class="band-labels">
          <text
            wx:for="{{phaseBands}}"
            wx:key="key"
            class="band-label {{activePhase === index ? 'active' : ''}}"
          >{{item.label}}</text>
        </view>

        <!-- 当前阶段该做什么：点击整行可改开学日期 -->
        <picker mode="date" start="{{dateStart}}" end="{{dateEnd}}" bindchange="onDateChange">
          <view class="advice-row" hover-class="cd-press" hover-stay-time="60">
            <text class="advice-text">{{advice}}</text>
            <text class="cd-edit">{{cdEdit}}</text>
          </view>
        </picker>

        <!-- 整理进度：一行带过，不抢倒计时的戏 -->
        <view class="hero-progress" wx:if="{{started}}">
          <text class="hero-progress-label">{{heroSub}}</text>
          <view class="hero-track"><view class="hero-fill" style="width:{{totalPercent}}%"></view></view>
        </view>
        <text class="hero-desc" wx:else>{{stageLabel}}共 {{totalCount}} 件，{{heroDesc}}</text>
      </view>

      <!-- 强 CTA：首页承接主入口，上移到倒计时 Hero 正下方——主任务「开始整理」首屏即可达（动线修复，其余块不动） -->
      <view class="cta-wrap">
        <view class="cta-btn" hover-class="cta-press" hover-stay-time="60" bindtap="onStartTap">
          <view class="cta-main">
            <text class="cta-title">{{ctaLabel}}</text>
            <text class="cta-sub">{{stageLabel}} · 已按必带/选带分好</text>
          </view>
          <text class="cta-arrow">›</text>
        </view>
      </view>

      <!-- 清单预览：首页直接展示真实物品，证明「替你想到了」（showPreview 可隐藏，便于 A/B 对比）
           2026-11-22：5 行竖排 → 横向胶囊，高度 ~400rpx 压到 ~130rpx，
           让学段切换 / 分类宫格 / CTA 进入首屏；物品名、必带选带、已勾状态都保留 -->
      <!-- 学段切换（默认大学选中） -->
      <text class="section-title">选择学段</text>
      <view class="stage-seg">
        <view
          wx:for="{{stages}}"
          wx:key="key"
          class="stage-pill {{stage === item.key ? 'active' : ''}}"
          hover-class="hv-press"
          hover-stay-time="60"
          data-key="{{item.key}}"
          bindtap="onStageTap"
        >{{item.label}}</view>
      </view>

      <!-- 清单范围切换：核心 20 件快速模式 / 完整清单 -->
      <view class="scope-row">
        <text class="scope-label">清单范围</text>
        <view class="scope-seg">
          <view
            class="scope-pill {{coreMode ? 'active' : ''}}"
            hover-class="hv-press"
            hover-stay-time="60"
            data-core="true"
            bindtap="onCoreModeTap"
          >核心 20 件</view>
          <view
            class="scope-pill {{!coreMode ? 'active' : ''}}"
            hover-class="hv-press"
            hover-stay-time="60"
            data-core="false"
            bindtap="onCoreModeTap"
          >完整清单</view>
        </view>
      </view>

      <!-- 清单抢先看：紧跟在学段/范围设置之后——先定学段，再看对应清单（2026-11-22 动线修复） -->
      <view class="preview-card" wx:if="{{showPreview}}">
        <view class="preview-head">
          <text class="preview-title">清单抢先看 · {{stageLabel}} · {{previewCount}} 件</text>
          <text class="preview-more" hover-class="hv-press" hover-stay-time="60" bindtap="onStartTap">去整理 ›</text>
        </view>
        <scroll-view class="preview-scroll" scroll-x>
          <view
            wx:for="{{previewItems}}"
            wx:key="id"
            class="chip {{item.must ? 'must' : 'opt'}} {{item.statusClass !== 'st0' ? 'done' : ''}}"
          >
            <view class="dot {{item.statusClass}}"></view>
            <text class="chip-name">{{item.name}}</text>
          </view>
          <view
            wx:if="{{previewCount > previewItems.length}}"
            class="chip chip-more"
            hover-class="hv-press"
            hover-stay-time="60"
            bindtap="onStartTap"
          >+{{previewCount - previewItems.length}} 件 ›</view>
        </scroll-view>
      </view>

      <!-- 分类宫格 -->
      <text class="section-title">入学物品分类</text>
      <view class="grid">
        <view
          wx:for="{{categories}}"
          wx:key="key"
          class="grid-cell"
          hover-class="hv-press"
          hover-stay-time="60"
          data-key="{{item.key}}"
          bindtap="onCategoryTap"
        >
          <view class="grid-icon" style="background:{{item.tint}}">
            <image class="grid-icon-img" src="/images/icons/ic-cat-{{item.key}}.svg" mode="aspectFit" />
          </view>
          <text class="grid-label">{{item.label}}</text>
          <text class="grid-count num">{{item.count}}</text>
        </view>
      </view>

      <!-- 今日整理小贴士（按日期轮换，纯本地） -->
      <view class="tips-card">
        <view class="tips-head">
          <image class="tips-ic" src="/images/icons/ic-backpack.svg" mode="aspectFit" />
          <text class="tips-title">今日开学小贴士</text>
        </view>
        <text class="tips-text">{{tip}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- 首次学段引导弹层（自定义半屏 2×2 卡片） -->
  <view wx:if="{{stageGuideVisible}}" class="sg-mask" bindtap="onStageGuideLater">
    <view class="sg-sheet" catchtap="noop">
      <view class="sg-handle"></view>
      <view class="sg-title">先选一个你的学段</view>
      <view class="sg-sub">清单会按学段调整，之后可在首页随时切换</view>
      <view class="sg-grid">
        <view
          wx:for="{{stages}}"
          wx:key="key"
          class="sg-card {{stage === item.key ? 'active' : ''}}"
          hover-class="hv-press"
          hover-stay-time="60"
          data-key="{{item.key}}"
          bindtap="onStageGuidePick"
        >
          <view class="sg-card-icon" style="background:{{item.color}}">{{item.short}}</view>
          <view class="sg-card-name">{{item.label}}</view>
          <view class="sg-card-desc">{{item.desc}}</view>
          <view wx:if="{{stage === item.key}}" class="sg-card-check">
            <view class="sg-card-check-inner"></view>
          </view>
        </view>
      </view>
      <view class="sg-later" hover-class="hv-press" hover-stay-time="60" bindtap="onStageGuideLater">稍后再说</view>
    </view>
  </view>
</view>
