.screen {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg-grad);
}

.content { flex: 1; overflow: hidden; }
.content-inner {
  padding: 20rpx var(--sp-screen-x) 0;
  padding-bottom: calc(var(--tab-bar-h) + env(safe-area-inset-bottom) + 30rpx);
  display: flex;
  flex-direction: column;
  gap: var(--sp-gap);
}

/* Streak 卡 */
.streak {
  background: linear-gradient(135deg, #ff9a5a 0%, #ff7a59 100%);
  border-radius: var(--r-card);
  padding: 38rpx;
  box-shadow: var(--shadow-2);
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #ffffff;
}
.streak-label { font-size: var(--fs-sub); opacity: 0.92; }
.streak-num-row { display: flex; align-items: baseline; margin-top: 10rpx; }
.streak-num { font-size: 76rpx; font-weight: 700; line-height: 1; }
.streak-unit { font-size: 31rpx; font-weight: 600; margin-left: 6rpx; }
.streak-medal {
  width: 110rpx;
  height: 110rpx;
  border-radius: 55rpx;
  background: rgba(255, 255, 255, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
}
.streak-medal-img { width: 60rpx; height: 60rpx; }

/* 学段切换 chips */
.chip-row { display: flex; gap: 16rpx; flex-wrap: wrap; }
.chip {
  padding: 14rpx 30rpx;
  background: #ffffff;
  border-radius: 999rpx;
  font-size: var(--fs-sub);
  font-weight: 600;
  color: var(--ink);
  box-shadow: var(--shadow-1);
  transition: transform 0.15s ease, opacity 0.15s ease;
}
.chip.active {
  background: var(--brand);
  color: #ffffff;
}

/* 分类完成度列表（可点导航） */
.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 8rpx;
}
.section-title { font-size: var(--fs-section); font-weight: 600; color: var(--ink); }
.section-sub { font-size: var(--fs-indicator); font-weight: 600; color: var(--brand); }
.cat-list { display: flex; flex-direction: column; gap: 20rpx; margin-top: 4rpx; }
.cat-row {
  background: #ffffff;
  border-radius: var(--r-card);
  padding: 24rpx;
  box-shadow: var(--shadow-1);
  display: flex;
  align-items: center;
  gap: 20rpx;
  transition: transform 0.15s ease, opacity 0.15s ease;
}
.cat-row.done { background: #f4fbf6; }
.cat-badge {
  width: 84rpx;
  height: 84rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.cat-icon-img { width: 50rpx; height: 50rpx; }
.cat-mid { flex: 1; min-width: 0; }
.cat-row-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.cat-name { font-size: var(--fs-body); font-weight: 600; color: var(--ink); }
.cat-pct { font-size: var(--fs-sub); font-weight: 600; color: var(--brand); }
.cat-track {
  height: 14rpx;
  background: var(--soft-blue);
  border-radius: 8rpx;
  overflow: hidden;
}
.cat-fill { height: 100%; background: var(--brand); border-radius: 8rpx; }
.cat-sub { display: block; margin-top: 10rpx; font-size: 22rpx; color: #a7b0c2; }
.cat-row.done .cat-sub { color: #36a96b; }
.cat-check { width: 40rpx; height: 40rpx; flex-shrink: 0; }
.cat-arrow { font-size: 40rpx; color: #c2cad6; flex-shrink: 0; line-height: 1; }

/* 成就 */
.badge-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 23rpx; }
.badge-cell {
  background: #ffffff;
  border-radius: var(--r-card);
  padding: 27rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  box-shadow: var(--shadow-1);
}
.badge-cell.locked { background: #eff3f7; }
.badge-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  background: var(--soft-blue);
  display: flex;
  align-items: center;
  justify-content: center;
}
.badge-cell.locked .badge-icon { background: #dfe6ee; }
.badge-img { width: 46rpx; height: 46rpx; }
.badge-cell.locked .badge-img { opacity: 0.4; }
.badge-name { font-size: var(--fs-indicator); font-weight: 600; color: var(--ink); text-align: center; }
.badge-state { font-size: 21rpx; color: var(--gray); }
.badge-cell.locked .badge-state { color: #9aa7b8; }
